{
  "config": {
    "step": {
      "user": {
        "title": "HA Thermo",
        "description": "Thermostats integration setup."
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "HA Thermo Options",
        "description": "Configure zones and settings."
      }
    }
  },
  "entity": {
    "sensor": {
      "current_temperature": {"name": "Current temperature"},
      "target_temperature": {"name": "Target"},
      "next_change": {"name": "Next change"},
      "bypass_remaining": {"name": "Bypass remaining"}
    },
    "binary_sensor": {
      "bypass_active": {"name": "Bypass active"},
      "override_active": {"name": "Override active"}
    },
    "select": {
      "profile": {"name": "Profile"}
    },
    "switch": {
      "enabled": {"name": "Auto control"}
    }
  },
  "services": {
    "set_profile": {
      "name": "Set profile",
      "description": "Activate a profile on all zones or on a selection.",
      "fields": {
        "profile": {"name": "Profile", "description": "Profile id or name, or __auto__."},
        "zones": {"name": "Zones", "description": "Zone ids or climate entity ids."},
        "duration": {"name": "Duration", "description": "Optional hold in minutes or HH:MM."}
      }
    },
    "start_bypass": {
      "name": "Start bypass",
      "description": "Temporarily override the target.",
      "fields": {
        "zones": {"name": "Zones", "description": "Zone ids or climate entity ids."},
        "temperature": {"name": "Temperature", "description": "Absolute temperature."},
        "offset": {"name": "Offset", "description": "Offset from target."},
        "duration": {"name": "Duration", "description": "Duration in minutes or HH:MM."},
        "until": {"name": "Until", "description": "ISO end datetime."},
        "source": {"name": "Source", "description": "Label to identify the source."}
      }
    },
    "stop_bypass": {
      "name": "Stop bypass",
      "description": "Stop the active bypass.",
      "fields": {
        "zones": {"name": "Zones", "description": "Zone ids or climate entity ids."}
      }
    },
    "set_temperature": {
      "name": "Set temperature",
      "description": "Set a temporary temperature.",
      "fields": {
        "zones": {"name": "Zones", "description": "Zone ids or climate entity ids."},
        "temperature": {"name": "Temperature", "description": "Temperature to set."},
        "duration": {"name": "Duration", "description": "Duration in minutes or HH:MM."}
      }
    },
    "enable": {
      "name": "Enable control",
      "description": "Enable or disable automatic control.",
      "fields": {
        "enabled": {"name": "Enabled", "description": "True to enable."},
        "zones": {"name": "Zones", "description": "Zone ids or climate entity ids."}
      }
    },
    "create_profile": {
      "name": "Create profile",
      "description": "Create a new profile."
    },
    "update_profile": {
      "name": "Update profile",
      "description": "Update an existing profile."
    },
    "delete_profile": {
      "name": "Delete profile",
      "description": "Delete a profile."
    },
    "clone_profile": {
      "name": "Clone profile",
      "description": "Clone an existing profile."
    },
    "reload": {
      "name": "Reload",
      "description": "Reload profiles."
    }
  }
}
